{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.skillpostapp.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.skillpostapp.com/:path*",
      "permanent": true
    }
  ]
}
